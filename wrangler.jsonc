{
  "name": "docs",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [{ "binding": "ARCHIVOS", "bucket_name": "docs-hardware" }],
  // database_id de `npx wrangler d1 create docs-site` (no es un secreto).
  "d1_databases": [{ "binding": "DB", "database_name": "docs-site", "database_id": "51396117-4867-4dfb-af4d-93f98d1264d7", "migrations_dir": "migrations" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash"
  }
}

{
  "name": "docs-site-lab",
  "private": true,
  "type": "module",
  "description": "Portal de documentación multi-proyecto (prueba) con login de GitHub",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "fetch": "node tools/fetch.mjs",
    "build": "node tools/fetch.mjs && astro build && node tools/postbuild.mjs && pagefind --site dist",
    "dev": "astro dev",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource-variable/raleway": "5.3.0",
    "@fontsource-variable/urbanist": "5.3.0",
    "@vercel/functions": "3.3.0",
    "astro": "7.3.8",
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1",
    "mermaid": "11.17.2",
    "pagefind": "1.4.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sigma": "3.0.3"
  }
}

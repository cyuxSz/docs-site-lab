---
// Esqueleto común: barra superior, búsqueda (Pagefind) y pie. El login lo resuelve middleware.js antes de servir.
// Fuentes de vanttec.com servidas desde el propio portal (la CSP no permite Google Fonts).
import "@fontsource-variable/nunito";
import "@fontsource-variable/raleway";
import "@fontsource-variable/urbanist";
import "../styles/global.css";
import temaScript from "../scripts/tema-inline.js?raw";
import { isRestricted } from "../../access.config.js";
import { ATAJOS } from "../lib/atajos.ts";
import { themeStyle, type ProjectTheme } from "../lib/data";
import type { Sugerencia } from "../lib/lectura.ts";

interface Props {
  title: string;
  description?: string;
  // Con proyecto: pestañas Resumen / Wiki / Grafo / Diagramas y sus colores (projectNav en lib/data.ts).
  project?: { id: string; name: string; theme?: ProjectTheme; wiki?: string; diagrams?: boolean; repoUrl?: string; sugerencias?: Sugerencia[]; disciplinas?: { id: string; etiqueta: string; href: string }[] };
  current?: "resumen" | "wiki" | "grafo" | "electronica" | "mecanica" | "caratula";
}
const { title, description = "Documentación de los proyectos de software de VantTec.", project, current } = Astro.props;
const sugerencias = project?.sugerencias ?? [];
// Electrónica y Mecánica se editan en la propia web (no viven en openwiki/ del repo).
const esDisciplina = current === "electronica" || current === "mecanica";
// Las pestañas son de Software: ni la carátula (su navegación son las tarjetas) ni las disciplinas las muestran.
const pestanasSoftware = !esDisciplina && current !== "caratula";
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline set:html={temaScript} />
    <slot name="head" />
  </head>
  <body data-pagefind-ignore={project && isRestricted(project.id) ? "all" : undefined} class:list={{ "has-proj": project?.theme }} style={themeStyle(project?.theme)}>
    <a class="sr-only skip-link" href="#contenido">Saltar al contenido</a>
    <header class="topbar">
      <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span><span>VantTEC <span class="brand-light">Docs</span></span></a>
      {project && <a class="crumb" href={`/${project.id}/`}>{project.name}</a>}
      <nav class="topnav" aria-label="Principal">
        <button class="search-btn" type="button" data-search-open aria-label="Buscar (Ctrl K o tecla /)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          <span>Buscar</span><kbd data-search-kbd>Ctrl K</kbd>
        </button>
        <button class="tema-btn" type="button" id="tema" aria-label="Tema oscuro activo. Cambiar a claro" title="Cambiar de tema">
          <svg class="ico-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          <svg class="ico-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"></path></svg>
        </button>
        <span class="user" id="user"></span>
        <a href="/auth/logout">Salir</a>
      </nav>
    </header>

    {project && pestanasSoftware && (
      <nav class="ptabs" aria-label={`Secciones de ${project.name}`}>
        <a href={`/${project.id}/software/`} data-astro-prefetch aria-current={current === "resumen" ? "page" : undefined}>Resumen</a>
        {project.wiki && <a href={project.wiki} data-astro-prefetch aria-current={current === "wiki" ? "page" : undefined}>Wiki</a>}
        <a href={`/${project.id}/grafo/`} data-astro-prefetch aria-current={current === "grafo" ? "page" : undefined}>Grafo</a>
        {project.diagrams && <a href={`/${project.id}/software/#diagramas`} data-astro-prefetch data-ptab-ancla="diagramas">Diagramas</a>}
        {project.repoUrl && <a href={project.repoUrl} class="ptab-ext">Código</a>}
      </nav>
    )}

    {project && esDisciplina && (
      <nav class="phead" aria-label={`Secciones de ${project.name}`}>
        <a href={`/${project.id}/`} data-astro-prefetch aria-label={`Volver a ${project.name}: Software, Electrónica y Mecánica`}><span aria-hidden="true">← </span>{project.name}</a>
        <span aria-current="page">{project.disciplinas?.find((d) => d.id === current)?.etiqueta ?? current}</span>
      </nav>
    )}

    <slot />

    <footer class="footer">
      <h3>¿Cómo se actualiza?</h3>
      {esDisciplina ? (
        <ol>
          <li>Esta documentación se edita en la propia web: quien tiene permiso de escritura usa «Editar» en cada página.</li>
          <li>Cada cambio guarda una versión nueva y el historial permite restaurar las anteriores.</li>
          <li>No hace falta hacer merge ni reconstruir el portal: los cambios se ven al guardar.</li>
        </ol>
      ) : (
        <ol>
          <li>Cada repo guarda su documentación en <code>openwiki/</code> y <code>docs/arch/</code>, junto al código.</li>
          <li>El CI confirma que las citas y el grafo ROS siguen coincidiendo con el código.</li>
          <li>Al hacer merge a <code>main</code>, el repo avisa a este portal y se reconstruye solo.</li>
        </ol>
      )}
      <slot name="footer" />
    </footer>

    <button class="to-top" type="button" id="to-top" aria-label="Volver arriba" hidden>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 15 7-7 7 7"></path></svg>
    </button>

    <dialog class="search-dialog" id="search" aria-label="Buscar en la documentación">
      <div class="search-bar"><strong>Buscar</strong><button type="button" data-search-close aria-label="Cerrar">×</button></div>
      <div id="pagefind" data-pagefind-ignore="all"></div>
      <div class="search-extra" data-search-extra data-pagefind-ignore="all" hidden>
        <div data-bloque-recientes hidden>
          <h3>Búsquedas recientes</h3>
          <ul data-recientes></ul>
          <button type="button" data-borrar-recientes hidden>Borrar recientes</button>
        </div>
        {sugerencias.length > 0 && (
          <div data-bloque-sugerencias>
            <h3>Sugerencias</h3>
            <ul>
              {sugerencias.map((s) => <li><a href={s.route}>{s.title}</a></li>)}
            </ul>
          </div>
        )}
      </div>
    </dialog>

    <dialog class="atajos-dialog" id="atajos" aria-labelledby="atajos-titulo" data-pagefind-ignore="all" data-wiki={project?.wiki ?? ""} data-grafo={project ? `/${project.id}/grafo/` : ""} data-novedades={project ? `/${project.id}/novedades/` : ""}>
      <div class="atajos-bar"><h2 id="atajos-titulo">Atajos de teclado</h2><button type="button" data-atajos-cerrar>Cerrar</button></div>
      <ul class="atajos-lista">
        {ATAJOS.map((a) => (
          <li><span class="atajos-teclas">{a.teclas.map((t) => <kbd>{t}</kbd>)}</span><span>{a.descripcion}</span></li>
        ))}
      </ul>
      <p class="atajos-nota">Los atajos se pausan mientras hay un diálogo abierto.</p>
    </dialog>

    <script>
      import "../scripts/atajos";
      // Buscador (Pagefind UI, recientes y ?q=): carga diferida, Ctrl/Cmd+K y "/".
      import "../scripts/busqueda";
      import { pestanaActiva } from "../lib/caratula.ts";
      // En pantallas estrechas las pestañas desbordan: la activa se acerca a la vista (sin animar si se pidió menos movimiento).
      // Solo se desplaza .ptabs en horizontal (scrollIntoView podía mover también ancestros verticales).
      // Diagramas es un ancla de /<id>/software/: con #diagramas, aria-current pasa de Resumen a Diagramas (y vuelve).
      const ptabs = document.querySelector<HTMLElement>(".ptabs");
      const resumenTab = ptabs?.querySelector<HTMLElement>("a[aria-current='page']:not([data-ptab-ancla])");
      const diagramasTab = ptabs?.querySelector<HTMLElement>("a[data-ptab-ancla='diagramas']");
      if (resumenTab && diagramasTab && location.pathname.endsWith("/software/")) {
        const sync = () => {
          const d = pestanaActiva(location.hash) === "diagramas";
          if (d) resumenTab.removeAttribute("aria-current");
          else resumenTab.setAttribute("aria-current", "page");
          if (d) diagramasTab.setAttribute("aria-current", "page");
          else diagramasTab.removeAttribute("aria-current");
        };
        sync();
        addEventListener("hashchange", sync);
      }
      const activa = document.querySelector<HTMLElement>(".ptabs a[aria-current]");
      const tabs = activa?.closest<HTMLElement>(".ptabs");
      if (activa && tabs) {
        const a = activa.getBoundingClientRect();
        const t = tabs.getBoundingClientRect();
        const dx = a.left < t.left ? a.left - t.left : a.right > t.right ? a.right - t.right : 0;
        if (dx) tabs.scrollTo({ left: tabs.scrollLeft + dx, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
      }
      // Enlaces a otros sitios (GitHub, papers) en otra pestaña, para que el portal siga abierto. Se decide al hacer
      // clic, así cubre también los enlaces que crean los componentes (panel del grafo, resultados de búsqueda).
      const external = (a: HTMLAnchorElement) => /^https?:$/.test(a.protocol) && a.host !== location.host;
      document.addEventListener(
        "click",
        (e) => {
          const a = (e.target as Element | null)?.closest?.("a[href]") as HTMLAnchorElement | null;
          if (a && external(a)) {
            a.target = "_blank";
            a.rel = "noopener noreferrer";
          }
        },
        true,
      );
      // En el texto se marcan desde el inicio: ícono ↗ (CSS) y aviso para lectores de pantalla.
      document.querySelectorAll<HTMLAnchorElement>(".prose a[href], .meta a[href], .ptabs a[href]").forEach((a) => {
        if (!external(a)) return;
        a.target = "_blank";
        a.rel = "noopener noreferrer";
        a.classList.add("ext");
        a.insertAdjacentHTML("beforeend", '<span class="sr-only"> (se abre en otra pestaña)</span>');
      });

      // Tema claro/oscuro: el script de <head> ya lo aplicó; el botón lo cambia, lo guarda y avisa con "tema-cambio"
      // (Mermaid y el grafo también observan data-theme).
      const temaBtn = document.getElementById("tema")!;
      const syncTema = () => {
        const claro = document.documentElement.dataset.theme === "light";
        temaBtn.setAttribute("aria-label", claro ? "Tema claro activo. Cambiar a oscuro" : "Tema oscuro activo. Cambiar a claro");
      };
      syncTema();
      temaBtn.addEventListener("click", () => {
        const claro = document.documentElement.dataset.theme !== "light";
        if (claro) document.documentElement.dataset.theme = "light";
        else delete document.documentElement.dataset.theme;
        try {
          localStorage.setItem("tema", claro ? "light" : "dark");
        } catch {}
        syncTema();
        document.dispatchEvent(new CustomEvent("tema-cambio", { detail: claro ? "light" : "dark" }));
      });

      // Volver arriba: aparece tras una pantalla de scroll y devuelve el foco al contenido.
      const toTop = document.getElementById("to-top")!;
      const onScroll = () => (toTop.hidden = scrollY < innerHeight);
      addEventListener("scroll", onScroll, { passive: true });
      onScroll();
      toTop.addEventListener("click", () => {
        const main = document.getElementById("contenido");
        scrollTo({ top: 0, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
        if (main) {
          main.setAttribute("tabindex", "-1");
          main.focus({ preventScroll: true });
        }
      });

      // Tablas en tarjetas (diseño A, teléfono): cada celda lleva el nombre de su columna.
      document.querySelectorAll<HTMLTableElement>(".prose table, .data-table").forEach((table) => {
        const heads = [...table.querySelectorAll("thead th")].map((th) => th.textContent?.trim() ?? "");
        table.querySelectorAll("tbody tr").forEach((tr) => {
          [...tr.children].forEach((td, i) => heads[i] && td.setAttribute("data-label", heads[i]));
        });
      });

      fetch("/auth/me")
        .then((r) => (r.ok ? r.json() : null))
        .then((me) => {
          if (me?.login) document.getElementById("user")!.textContent = `@${me.login}`;
        })
        .catch(() => {});
    </script>
  </body>
</html>

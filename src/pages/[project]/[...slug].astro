---
// Una página de la wiki, ya renderizada en el build (sin fetch en el navegador).
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import SideNav from "../../components/SideNav.astro";
import RutasRol from "../../components/RutasRol.astro";
import TutorialesLista from "../../components/TutorialesLista.astro";
import TutorialPasos from "../../components/TutorialPasos.astro";
import Comentarios from "../../components/Comentarios.astro";
import { builtProjects, project as load, fmtDate, projectNav, sections, slugReservado, STATUS_LABEL } from "../../lib/data";
import { isRestricted } from "../../../access.config.js";
import { TYPE_LABEL } from "../../lib/labels";
import { anteriorSiguiente, migas } from "../../lib/navegacion.ts";
import { firmaPagina } from "../../lib/personal.ts";
import { urlEditar, urlReportar } from "../../lib/acciones.ts";
import { citasDe } from "../../../tools/citas.mjs";
import { minutosLectura, nivelPagina } from "../../lib/lectura.ts";

export async function getStaticPaths() {
  const ok = new Set(builtProjects().map((p) => p.id));
  const docs = await getCollection("docs", (d) => ok.has(d.data.project) && d.data.path !== "index.md");
  const disciplinas = new Map(builtProjects().map((p) => [p.id, Object.keys(p.disciplinas ?? {})]));
  return docs.flatMap((entry) => {
    const slug = entry.data.path.replace(/\.md$/, "").replace(/(^|\/)index$/, "");
    // Una página de la wiki no puede ocupar una ruta fija ni una disciplina: se avisa y no se genera.
    if (slugReservado(slug, disciplinas.get(entry.data.project))) {
      console.warn(`[${entry.data.project}] la página «${entry.data.path}» choca con una ruta del portal (/${slug}/) y no se genera.`);
      return [];
    }
    return [{ params: { project: entry.data.project, slug }, props: { entry } }];
  });
}

const { entry } = Astro.props;
const p = load(entry.data.project);
const { Content, headings } = await render(entry);
const route = `/${p.id}/${Astro.params.slug}/`;
// Proyecto restringido: la exclusión real del índice es data-pagefind-ignore="all" en el body (Base.astro); no se debe quitar (access.config.js).
const restricted = isRestricted(p.id);
// Índice "En esta página": h2 y, sangrados, h3.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const pkg = entry.data.path.startsWith("packages/") ? entry.data.path.replace(/^packages\/|\.md$/g, "") : null;
const historial = p.pageList.find((x) => x.path === entry.data.path)?.historial ?? [];
const rosNodes = pkg && p.ros ? p.ros.nodes.filter((n) => n.category === "ros2_node" && n.package === pkg) : [];
// Encabezado al estilo de vanttec.com: sección en mayúsculas espaciadas sobre el título de la página.
const section = sections(p.pageList).find((s) => s.pages.some((x) => x.route === route))?.label;
const hasMermaid = entry.body?.includes("```mermaid") ?? false;
const crumbs = migas(p.pageList, route, { id: p.id, name: p.name });
const { prev, next } = anteriorSiguiente(p.pageList, route);
const editar = urlEditar(p.repo, p.branch, entry.data.path);
const pageRef = { title: entry.data.title, route, path: entry.data.path };
// Vista previa de las citas de esta página: solo las líneas ya extraídas en el build (tools/citas.mjs).
const citas = p.repoUrl && p.sha ? citasDe(entry.body ?? "", p.repoUrl, p.sha).flatMap((c) => (p.citas?.[c.key] ? [{ ...c, ...p.citas[c.key] }] : [])) : [];
// Rutas por rol: rutas.md se vuelve checklist si el proyecto tiene rutas válidas; las demás páginas muestran su paso al pie.
const esRutas = entry.data.path === "rutas.md" && Boolean(p.rutas?.length || p.tutoriales?.length);
// Mini tutoriales: la página openwiki/rutas/<slug>.md de un tutorial válido se vuelve checklist.
const tutorial = p.tutoriales?.find((t) => t.page === entry.data.path);
const rutasDePagina = esRutas ? [] : (p.rutas ?? []).filter((r) => r.pasos.some((s) => s.page === entry.data.path));
const firma = firmaPagina(entry.data.updated, p.pageList.find((x) => x.path === entry.data.path)?.commit);
// Tiempo de lectura y nivel, calculados en el build (heurística documentada en lib/lectura.ts).
const minutos = minutosLectura(entry.body ?? "");
const nivel = nivelPagina({ level: entry.data.level, type: entry.data.type, path: entry.data.path, claims: entry.data.claims, enRuta: esRutas || Boolean(tutorial) || rutasDePagina.length > 0 });
const glosario = p.pageList.find((x) => x.path === "glosario.md");
---
<Base title={`${entry.data.title} · ${p.name}`} description={entry.data.description} project={projectNav(p)} current="wiki">
  <div class="container">
    <div class="doc doc-wiki">
      <div class="barra-caja barra-caja-izq">
        <button type="button" class="barra-btn" data-barra="izq" aria-controls="barra-izq" aria-expanded="true" aria-label="Ocultar navegación" title="Ocultar navegación"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M9 4v16"></path></svg></button>
        <SideNav id="barra-izq" projectId={p.id} projectName={p.name} pages={p.pageList} currentRoute={route} rutas={p.rutas?.length ? `/${p.id}/rutas/` : undefined} hasDiagrams={p.diagramList.length > 0} />
      </div>
      <main id="contenido" tabindex="-1">
        <div class="barras-movil" data-pagefind-ignore="all">
          <button type="button" data-barra="izq" aria-controls="barra-izq" aria-expanded="false" aria-label="Mostrar navegación" title="Mostrar navegación"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg></button>
          <button type="button" data-barra="der" aria-controls="barra-der" aria-expanded="false" aria-label="Mostrar índice" title="Mostrar índice"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M15 4v16"></path></svg></button>
        </div>
        <nav class="migas" aria-label="Migas" data-pagefind-ignore="all">
          <ol>
            {crumbs.map((c, i) => (
              <li>{c.href ? <a href={c.href} data-astro-prefetch>{c.label}</a> : <span aria-current={i === crumbs.length - 1 ? "page" : undefined}>{c.label}</span>}</li>
            ))}
          </ol>
        </nav>
        <div data-pagina data-proyecto={p.id} data-route={route} data-title={entry.data.title} data-firma={firma} data-pagefind-ignore="all">
          <div class="aviso-cambio" role="status" hidden>
            <span>Esta página cambió desde tu última visita · <a href={`/${p.id}/novedades/`}>ver en Novedades</a></span>
            <button type="button" class="aviso-cerrar" data-descartar aria-label="Descartar aviso">×</button>
          </div>
          <button type="button" class="favorito-btn" data-favorito aria-pressed="false" aria-label="Guardar en favoritos" title="Guardar en favoritos" hidden>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"></path></svg>
          </button>
          <details class="lectura-ajustes" data-lectura-ajustes>
            <summary>Ajustes de texto</summary>
            <fieldset>
              <legend>Tamaño de letra</legend>
              <label><input type="radio" name="letra" value="s" /> Pequeña</label>
              <label><input type="radio" name="letra" value="m" /> Normal</label>
              <label><input type="radio" name="letra" value="l" /> Grande</label>
            </fieldset>
            <fieldset>
              <legend>Ancho de lectura</legend>
              <label><input type="radio" name="ancho" value="estrecho" /> Estrecho</label>
              <label><input type="radio" name="ancho" value="normal" /> Normal</label>
              <label><input type="radio" name="ancho" value="ancho" /> Ancho</label>
            </fieldset>
          </details>
        </div>
        <article class="prose" data-pagefind-body={restricted ? undefined : ""} data-glosario={glosario && glosario.route !== route ? glosario.route : undefined}>
          {!restricted && <meta data-pagefind-filter="proyecto[content]" content={p.name} />}
          {!restricted && <meta data-pagefind-filter="tipo[content]" content={TYPE_LABEL[entry.data.type] ?? entry.data.type} />}
          {!restricted && pkg && <meta data-pagefind-filter="paquete[content]" content={pkg} />}
          <p class="eyebrow page-eyebrow">{p.tagline ?? p.name}{section && ` · ${section}`}</p>
          <p class="lectura-meta" data-pagefind-ignore><span>{minutos} min de lectura</span><span data-nivel={nivel.nivel}>{nivel.etiqueta}</span></p>
          {esRutas ? (
            <>
              <h1>{entry.data.title}</h1>
              {entry.data.description && <p class="lead">{entry.data.description}</p>}
              {p.rutas?.length ? <RutasRol projectId={p.id} rutas={p.rutas} /> : null}
              {p.tutoriales?.length ? <TutorialesLista projectId={p.id} tutoriales={p.tutoriales} /> : null}
            </>
          ) : tutorial ? (
            <>
              <h1>{tutorial.titulo}</h1>
              {tutorial.descripcion && <p class="lead">{tutorial.descripcion}</p>}
              <TutorialPasos projectId={p.id} tutorial={tutorial} />
            </>
          ) : <Content />}
        </article>
        <div class="resaltado-barra" data-resaltado role="status" data-pagefind-ignore="all" hidden>
          <span data-resaltado-texto></span>
          <button type="button" data-quitar-resaltado>Quitar resaltado</button>
        </div>
        {(prev || next) && (
          <nav class="prevnext" aria-label="Anterior y siguiente" data-pagefind-ignore="all">
            {prev ? <a class="prev" href={prev.route} rel="prev" data-astro-prefetch><span>← Anterior</span><strong>{prev.label}</strong></a> : <span />}
            {next ? <a class="next" href={next.route} rel="next" data-astro-prefetch><span>Siguiente →</span><strong>{next.label}</strong></a> : <span />}
          </nav>
        )}
        <Comentarios pagina={route} />
        {rutasDePagina.length > 0 && (
          <aside class="ruta-paso" hidden data-pagefind-ignore="all" aria-label="Ruta de lectura" data-proyecto={p.id} data-page={entry.data.path} data-rutas={JSON.stringify(rutasDePagina)}></aside>
        )}
        {citas.map((c) => (
          <template data-cita={c.key} data-file={c.file} data-start={c.start} data-end={c.end} data-truncated={c.truncated ? "1" : undefined} data-pagefind-ignore="all">
            <pre><code>{c.lines.join("\n")}</code></pre>
          </template>
        ))}
      </main>
      <div class="barra-caja barra-caja-der">
      <button type="button" class="barra-btn" data-barra="der" aria-controls="barra-der" aria-expanded="true" aria-label="Ocultar índice" title="Ocultar índice"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M15 4v16"></path></svg></button>
      <aside class="meta" id="barra-der" aria-label="Datos de la página" data-pagefind-ignore="all">
        <dl>
          <div>
            <dt>Actualizado</dt>
            <dd>
              {entry.data.updated ? <time datetime={entry.data.updated} data-hace>{fmtDate(entry.data.updated)}</time> : fmtDate(entry.data.updated)}
              {entry.data.author && <span class="muted"> · {entry.data.author}</span>}
            </dd>
          </div>
          {entry.data.claims > 0 && <div><dt>Afirmaciones</dt><dd>{entry.data.claims} verificadas contra el código</dd></div>}
          {entry.data.owner && <div><dt>Responsable</dt><dd>{entry.data.owner}</dd></div>}
          <div><dt>Fuente</dt><dd><a href={entry.data.source}>Ver en GitHub</a></dd></div>
          <div>
            <dt>Mejorar esta página</dt>
            <dd class="acciones">
              <a href={editar}>Editar en GitHub</a>
              <a href={urlReportar(p.repo, pageRef)} data-reportar data-repo={p.repo} data-title={pageRef.title} data-route={pageRef.route} data-path={pageRef.path}>Reportar un error</a>
            </dd>
          </div>
          {rosNodes.length > 0 && (
            <div>
              <dt>Nodos en el grafo</dt>
              <dd>
                <ul style="list-style:none;margin:4px 0 0;padding:0;display:grid;gap:4px">
                  {rosNodes.map((n) => (
                    <li><a href={`/${p.id}/grafo/?node=${encodeURIComponent(n.id)}`}><code>{n.label}</code></a> <span class={`badge badge-${n.status}`}>{STATUS_LABEL[n.status ?? ""]}</span></li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
        </dl>
        {historial.length > 0 && (
          <details class="historial">
            <summary>Historial</summary>
            <ol>
              {historial.map((c) => (
                <li>
                  <span>{c.mensaje}</span>
                  <span class="hist-meta"><time datetime={c.fecha}>{fmtDate(c.fecha)}</time> · {c.autor}</span>
                  <span class="hist-enlaces">
                    <a href={c.url} aria-label={`Commit ${c.sha}`}><code>{c.corto}</code></a>
                    <a href={c.diff} aria-label={`Ver diff del commit ${c.corto}`}>ver diff</a>
                  </span>
                </li>
              ))}
            </ol>
          </details>
        )}
        {toc.length > 1 && (
          <nav class="toc-box" aria-labelledby="toc-title">
            <p class="toc-title" id="toc-title">En esta página</p>
            <ul class="toc">
              {toc.map((h) => <li class={h.depth === 3 ? "toc-sub" : undefined}><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ul>
          </nav>
        )}
      </aside>
      </div>
    </div>
  </div>
  <div class="barras-velo" data-barras-velo hidden></div>
  {hasMermaid && (
    <script>
      import { renderMermaid } from "../../scripts/mermaid";
      renderMermaid();
    </script>
  )}
  <script>
    import "../../scripts/prose";
    import "../../scripts/rutas";
    import "../../scripts/personal";
    import "../../scripts/lectura";
    import "../../scripts/comentarios";
    import "../../scripts/barras";
  </script>
</Base>

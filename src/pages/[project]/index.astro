---
// Carátula del proyecto: título, arte del vehículo y tarjetas Software · Electrónica · Mecánica.
// La portada de software vive en software.astro. Un proyecto sin disciplinas salta directo a Software.
import Base from "../../layouts/Base.astro";
import VehicleArt from "../../components/VehicleArt.astro";
import EstadoProyecto from "../../components/EstadoProyecto.astro";
import { portal, project as load, projectNav, tarjetasCaratula } from "../../lib/data";
import type { ProjectData } from "../../lib/data";
import { conteoNodos } from "../../lib/conteos.ts";

export function getStaticPaths() {
  return portal().projects.map((p) => ({ params: { project: p.id } }));
}

const { builtAt, projects } = portal();
const resumen = projects.find((x) => x.id === Astro.params.project)!;
// Un proyecto con error o vacío no tiene data/<id>.json (y no se llama a load()): solo se muestra su estado.
const sinConstruir = Boolean(resumen.error || resumen.empty);
const p = (sinConstruir ? resumen : load(resumen.id)) as ProjectData;
const tarjetas = sinConstruir ? [] : tarjetasCaratula(p);
const conSoloSoftware = tarjetas.length <= 1;
const conteo = conteoNodos(sinConstruir ? [] : p.ros?.nodes ?? []);
---
{sinConstruir ? (
  <Base title={`${p.name} · VantTec Docs`} description={p.summary}>
    <div class="container">
      <main id="contenido" tabindex="-1" class="estado-pagina" data-pagefind-ignore="all">
        <h1>{p.name}</h1>
        <EstadoProyecto p={resumen} builtAt={builtAt} />
        <p><a href="/">← Volver al inicio</a></p>
      </main>
    </div>
  </Base>
) : conSoloSoftware ? (
  <Base title={`${p.name} · VantTec Docs`} description={p.summary} project={projectNav(p)} current="caratula">
    <meta http-equiv="refresh" content={`0; url=/${p.id}/software/`} slot="head" />
    <div class="container">
      <main id="contenido" tabindex="-1" data-caratula-redirige data-pagefind-ignore="all">
        <h1>{p.name}</h1>
        <p><a class="btn btn-primary" href={`/${p.id}/software/`}>Ir a Software</a></p>
      </main>
    </div>
    <script>
      import "../../scripts/caratula";
    </script>
  </Base>
) : (
  <Base title={`${p.name} · VantTec Docs`} description={p.summary} project={projectNav(p)} current="caratula">
    <div class="container">
      <main id="contenido" tabindex="-1" class="caratula" data-pagefind-ignore="all">
        <section class="hero phero">
          <div>
            <p class="eyebrow">{p.tagline ?? "Proyecto"}</p>
            <h1>{p.name}</h1>
            <p class="lead">{p.summary}</p>
            {p.note && <p class="card-note">{p.note}</p>}
          </div>
          <VehicleArt kind={p.kind} image={p.image} alt={`Ilustración de ${p.name}`} />
        </section>
        <section class="block">
          <div class="cards caratula-cards">
            {tarjetasCaratula(p).map((t) =>
              t.id === "software" ? (
                <a class="card caratula-card" href={t.href} data-astro-prefetch data-caratula="software">
                  <span class="card-title">{t.titulo}</span>
                  <span class="card-desc">{t.descripcion}</span>
                  <span class="card-meta caratula-cifras">
                    {p.pages} páginas · {p.claims} afirmaciones{p.ros ? ` · ${conteo.enUso} nodos ROS en uso` : ""}
                  </span>
                </a>
              ) : (
                <a class="card caratula-card" href={t.href} data-astro-prefetch data-caratula-hw={t.id} data-proyecto={p.id}>
                  <span class="card-title">{t.titulo}</span>
                  <span class="card-desc">{t.descripcion}</span>
                  <span class="card-meta caratula-cifras" data-caratula-cifras></span>
                </a>
              ),
            )}
          </div>
        </section>
      </main>
    </div>
    <script>
      import "../../scripts/caratula";
    </script>
  </Base>
)}

---
// Documentación de hardware (Electrónica / Mecánica) de un proyecto. La página es estática: el script
// (src/scripts/hardware-editor.ts) lee y, con permiso de escritura, escribe por /api/hardware/ con la sesión del usuario.
import Base from "../../layouts/Base.astro";
import Comentarios from "../../components/Comentarios.astro";
import { builtProjects, project as load, projectNav } from "../../lib/data";

export function getStaticPaths() {
  return builtProjects().flatMap((p) => Object.keys(p.disciplinas ?? {}).map((d) => ({ params: { project: p.id, disciplina: d } })));
}

const disciplina = Astro.params.disciplina as "electronica" | "mecanica";
const p = load(Astro.params.project!);
const etiqueta = projectNav(p).disciplinas.find((d) => d.id === disciplina)?.etiqueta ?? disciplina;
---
<Base title={`${etiqueta} · ${p.name}`} description={`Documentación de ${etiqueta.toLowerCase()} de ${p.name}.`} project={projectNav(p)} current={disciplina}>
  <div class="container">
    <div class="doc doc-wiki" data-hw-proyecto={p.id} data-hw-disciplina={disciplina} data-hw-etiqueta={etiqueta}>
      <div class="barra-caja barra-caja-izq">
        <button type="button" class="barra-btn" data-barra="izq" aria-controls="barra-izq" aria-expanded="true" aria-label="Ocultar navegación" title="Ocultar navegación"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M9 4v16"></path></svg></button>
        <nav class="sidenav" id="barra-izq" aria-label={`Páginas de ${etiqueta}`} data-pagefind-ignore="all">
          <div class="sidenav-list">
            <h2>{etiqueta}</h2>
            <ul class="hw-indice" data-hw-indice></ul>
            <p class="hw-nueva" data-hw-solo-editor hidden>
              <button type="button" class="btn" data-hw-nueva>Nueva página</button>
            </p>
          </div>
        </nav>
      </div>
      <main id="contenido" tabindex="-1">
        <div class="barras-movil" data-pagefind-ignore="all">
          <button type="button" data-barra="izq" aria-controls="barra-izq" aria-expanded="false" aria-label="Mostrar navegación" title="Mostrar navegación"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg></button>
          <button type="button" data-barra="der" aria-controls="barra-der" aria-expanded="false" aria-label="Mostrar datos de la página" title="Mostrar datos de la página"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M15 4v16"></path></svg></button>
        </div>
        <p class="eyebrow page-eyebrow">{p.tagline ?? p.name} · {etiqueta}</p>
        <p class="hw-estado" data-hw-estado aria-live="polite">Cargando {etiqueta.toLowerCase()}…</p>
        <p class="hw-error" data-hw-error role="alert" hidden></p>

        <section class="hw-vacio" data-hw-vacio hidden>
          <p data-hw-vacio-texto>Todavía no hay páginas en {etiqueta}</p>
          <button type="button" class="btn btn-primary" data-hw-inicializar hidden>Inicializar desde plantilla</button>
        </section>

        <section class="hw-no-encontrada" data-hw-no-encontrada hidden>
          <p>Página no encontrada</p>
          <a href="#" data-hw-primera>Ir a la primera página</a>
        </section>

        <section class="hw-pagina" data-hw-pagina hidden>
          <div class="hw-barra" data-hw-solo-editor hidden>
            <button type="button" class="btn" data-hw-editar>Editar</button>
            <button type="button" class="btn" data-hw-borrar>Borrar página</button>
          </div>
          <article class="prose hw-lectura" data-hw-lectura data-pagefind-ignore="all"></article>

          <form class="hw-editor" data-hw-editor hidden novalidate>
            <div class="hw-pestanas" role="tablist" aria-label="Modo del editor">
              <button type="button" class="btn" role="tab" id="hw-tab-escribir" aria-selected="true" aria-controls="hw-panel-escribir" data-hw-tab="escribir">Escribir</button>
              <button type="button" class="btn" role="tab" id="hw-tab-previa" aria-selected="false" aria-controls="hw-panel-previa" tabindex="-1" data-hw-tab="previa">Vista previa</button>
            </div>
            <div class="campo hw-panel" id="hw-panel-escribir" role="tabpanel" aria-labelledby="hw-tab-escribir">
              <label for="hw-md">Contenido en Markdown</label>
              <textarea id="hw-md" name="md" rows="22" spellcheck="false" autocomplete="off" aria-describedby="hw-ayuda-md"></textarea>
              <p class="hw-ayuda" id="hw-ayuda-md">Puedes pegar o arrastrar imágenes y archivos sobre el texto.</p>
            </div>
            <div class="prose hw-previa" id="hw-panel-previa" role="tabpanel" aria-labelledby="hw-tab-previa" data-hw-previa tabindex="0" hidden></div>
            <div class="hw-subida">
              <input type="file" id="hw-archivo" class="hw-archivo" />
              <label for="hw-archivo" class="btn">Adjuntar</label>
              <progress class="hw-progreso" data-hw-progreso max="100" value="0" aria-label="Progreso de la subida" hidden></progress>
              <span class="hw-subiendo" data-hw-subiendo aria-live="polite"></span>
            </div>
            <p class="hw-error" data-hw-editor-error role="alert" hidden></p>
            <div class="hw-acciones">
              <button type="submit" class="btn btn-primary" data-hw-guardar>Guardar</button>
              <button type="button" class="btn" data-hw-cancelar>Cancelar</button>
            </div>
          </form>

          <div class="hw-comentarios" data-hw-comentarios data-pagefind-ignore="all" hidden>
            <Comentarios pagina={`/${p.id}/${disciplina}/`} />
          </div>
        </section>
      </main>
      <div class="barra-caja barra-caja-der">
        <button type="button" class="barra-btn" data-barra="der" aria-controls="barra-der" aria-expanded="true" aria-label="Ocultar datos de la página" title="Ocultar datos de la página"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M15 4v16"></path></svg></button>
        <aside class="meta" id="barra-der" aria-label="Datos de la página" data-pagefind-ignore="all">
          <dl>
            <div><dt>Autor</dt><dd data-hw-autor>—</dd></div>
            <div><dt>Actualizado</dt><dd><time data-hw-actualizado>—</time></dd></div>
            <div><dt>Versión</dt><dd data-hw-version>—</dd></div>
          </dl>
          <details class="historial hw-historial" data-hw-historial hidden>
            <summary>Historial</summary>
            <p class="hw-ayuda" data-hw-historial-estado aria-live="polite"></p>
            <ol data-hw-revisiones></ol>
          </details>
        </aside>
      </div>
    </div>
  </div>
  <div class="barras-velo" data-barras-velo hidden></div>

  <dialog class="atajos-dialog" id="hw-nueva" aria-labelledby="hw-nueva-titulo">
    <form data-hw-nueva-form novalidate>
      <div class="atajos-bar"><h2 id="hw-nueva-titulo">Nueva página</h2></div>
      <div class="campo hw-dialogo-cuerpo">
        <label for="hw-nueva-nombre">Título de la página</label>
        <input type="text" id="hw-nueva-nombre" name="titulo" maxlength="120" autocomplete="off" />
        <p class="hw-error" data-hw-nueva-error role="alert" hidden></p>
      </div>
      <div class="atajos-bar">
        <button type="submit" data-hw-ok>Crear</button>
        <button type="button" data-hw-no>Cancelar</button>
      </div>
    </form>
  </dialog>
  <dialog class="atajos-dialog" id="hw-borrar" aria-labelledby="hw-borrar-titulo">
    <div class="atajos-bar"><h2 id="hw-borrar-titulo">Borrar página</h2></div>
    <p class="atajos-nota" data-hw-borrar-texto>La página irá a la papelera.</p>
    <div class="atajos-bar">
      <button type="button" data-hw-ok>Borrar</button>
      <button type="button" data-hw-no>Cancelar</button>
    </div>
  </dialog>
  <dialog class="atajos-dialog" id="hw-descartar" aria-labelledby="hw-descartar-titulo">
    <div class="atajos-bar"><h2 id="hw-descartar-titulo">Descartar cambios</h2></div>
    <p class="atajos-nota">Hay cambios sin guardar. Si cancelas se perderán.</p>
    <div class="atajos-bar">
      <button type="button" data-hw-ok>Descartar</button>
      <button type="button" data-hw-no>Seguir editando</button>
    </div>
  </dialog>

  <script>
    import "../../scripts/hardware-editor";
    import "../../scripts/barras";
  </script>
</Base>

---
import Base from "../layouts/Base.astro";
import { portal, fmtDate } from "../lib/data";

const { builtAt, alerts, projects } = portal();
const built = new Date(builtAt).toLocaleString("es-MX", { dateStyle: "medium", timeStyle: "short", timeZone: "America/Monterrey" });
---
<Base title="VantTec · Documentación">
  <main class="container narrow" id="contenido">
    <section class="hero">
      <p class="eyebrow">Portal de documentación</p>
      <h1>Cómo funciona cada proyecto</h1>
      <p class="lead">Arquitectura, estado real del código, grafo de nodos ROS y wiki de cada repositorio. Todo se genera desde los propios repos: cada afirmación enlaza a la línea de código que la respalda.</p>
    </section>

    {alerts.map((a) => <p class={`alert alert-${a.level}`} role="status">{a.text}</p>)}

    <section class="block">
      <div class="block-head"><h2>Proyectos</h2></div>
      <div class="cards cards-wide">
        {projects.map((p) => {
          const ok = !p.error && !p.empty;
          const Tag = ok ? "a" : "div";
          return (
            <Tag class:list={["card", { "is-off": !ok, "is-error": p.error }]} href={ok ? `/${p.id}/` : undefined}>
              <span class="card-title">{p.name}</span>
              {p.note && <span class="card-note">{p.note}</span>}
              <span class="card-desc">{p.summary}</span>
              {ok ? (
                <span class="card-meta">
                  {p.pages} páginas · {p.claims} afirmaciones verificadas
                  {p.rosNodes ? ` · ${p.rosNodes} elementos en el grafo ROS` : ""}
                  {p.diagrams ? ` · ${p.diagrams} diagrama(s)` : ""} · actualizado {fmtDate(p.updated)}
                </span>
              ) : (
                <span class="card-status">{p.message}</span>
              )}
              <span class="card-link">{ok ? "Abrir →" : p.error ? "No se pudo construir" : "Sin documentación aún"}</span>
            </Tag>
          );
        })}
      </div>
    </section>
  </main>
  <p slot="footer">Portal construido el {built}.</p>
</Base>

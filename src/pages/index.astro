---
import Base from "../layouts/Base.astro";
import VehicleArt from "../components/VehicleArt.astro";
import { isRestricted } from "../../access.config.js";
import { portal, fmtDate, themeStyle } from "../lib/data";

const { builtAt, alerts, projects } = portal();
const built = new Date(builtAt).toLocaleString("es-MX", { dateStyle: "medium", timeStyle: "short", timeZone: "America/Monterrey" });
const ok = projects.filter((p) => !p.error && !p.empty);
// Los proyectos restringidos no suman a los contadores ni son el destino de "Explorar".
const open = ok.filter((p) => !isRestricted(p.id));
const sum = (k: "pages" | "claims" | "rosNodes") => open.reduce((n, p) => n + (p[k] ?? 0), 0);
const counters = [
  { label: "Proyectos", value: open.length },
  { label: "Páginas de wiki", value: sum("pages") },
  { label: "Afirmaciones verificadas", value: sum("claims") },
  { label: "Elementos ROS", value: sum("rosNodes") },
];
const first = open[0];
---
<Base title="VantTec · Documentación">
  <main class="container narrow" id="contenido">
    <section class="hero hero-home">
      <p class="eyebrow">VantTEC · Documentación técnica</p>
      <h1>Navegando el <span class="grad">código</span> de cada vehículo</h1>
      <p class="lead">Arquitectura, estado real del código, grafo de nodos ROS y wiki de cada repositorio. Todo se genera desde los propios repos: cada afirmación enlaza a la línea de código que la respalda.</p>
      <div class="hero-cta">
        {first && <a class="btn btn-primary btn-lg" href={`/${first.id}/`}>Explorar {first.name.split(" · ")[0]}</a>}
        <button class="btn btn-lg" type="button" data-search-open>Buscar en la documentación</button>
      </div>
    </section>

    <dl class="stats counters">
      {counters.map((c) => (
        <div><dt>{c.label}</dt><dd data-count={c.value}>{c.value}</dd></div>
      ))}
    </dl>

    {alerts.map((a) => <p class={`alert alert-${a.level}`} role="status">{a.text}</p>)}

    <section class="block">
      <div class="block-head"><h2>Vehículos y proyectos</h2></div>
      <div class="vcards">
        {projects.map((p) => {
          const live = !p.error && !p.empty;
          const Tag = live ? "a" : "div";
          if (isRestricted(p.id)) {
            return (
              <Tag class:list={["vcard", { "is-off": !live }]} href={live ? `/${p.id}/` : undefined} style={themeStyle(p.theme)}>
                <VehicleArt kind={p.kind} image={p.image} alt={`Ilustración de ${p.name}`} />
                <div class="vcard-body">
                  <span class="card-title">{p.name}</span>
                  <span class="badge-restricted">Acceso restringido</span>
                </div>
              </Tag>
            );
          }
          return (
            <Tag class:list={["vcard", { "is-off": !live, "is-error": p.error }]} href={live ? `/${p.id}/` : undefined} style={themeStyle(p.theme)}>
              <VehicleArt kind={p.kind} image={p.image} alt={`Ilustración de ${p.name}`} />
              <div class="vcard-body">
                <span class="eyebrow">{p.tagline ?? "Proyecto"}</span>
                <span class="card-title">{p.name}</span>
                {p.note && <span class="card-note">{p.note}</span>}
                <span class="card-desc">{p.summary}</span>
                {live ? (
                  <span class="vcard-chips">
                    <span>{p.pages} páginas</span>
                    <span>{p.claims} afirmaciones</span>
                    {p.rosNodes ? <span>{p.rosNodes} elementos ROS</span> : null}
                    {p.diagrams ? <span>{p.diagrams} diagrama(s)</span> : null}
                  </span>
                ) : (
                  <span class="card-status">{p.message}</span>
                )}
                <span class="card-meta">{live ? `Actualizado ${fmtDate(p.updated)}` : ""}</span>
                <span class="card-link">{live ? "Abrir →" : p.error ? "No se pudo construir" : "Sin documentación aún"}</span>
              </div>
            </Tag>
          );
        })}
      </div>
    </section>
  </main>
  <p slot="footer">Portal construido el {built}.</p>
  <script>
    // Contadores que suben al entrar en pantalla, como los de vanttec.com. El número final ya está en el HTML.
    const els = [...document.querySelectorAll<HTMLElement>("[data-count]")];
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        const t0 = performance.now();
        const tick = (t: number) => {
          const k = Math.min(1, (t - t0) / 1200);
          const ease = 1 - (1 - k) ** 3;
          els.forEach((el) => (el.textContent = String(Math.round(Number(el.dataset.count) * ease))));
          if (k < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
      els.forEach((el) => io.observe(el));
    }
  </script>
</Base>

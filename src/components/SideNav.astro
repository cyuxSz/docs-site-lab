---
// Navegación de la wiki por secciones. En celular queda plegada detrás de un botón; el estado inicial lo decide
// el CSS (no un script después de pintar) para no mover la página al cargar.
import { sections, type PageInfo } from "../lib/data";

interface Props {
  projectId: string;
  projectName: string;
  pages: PageInfo[];
  currentRoute?: string;
  hasDiagrams: boolean;
  // Ruta de /<id>/rutas/ cuando el proyecto tiene rutas por rol.
  rutas?: string;
}
const { projectId, projectName, pages, currentRoute, hasDiagrams, rutas } = Astro.props;
---
<nav class="sidenav" aria-label={`Páginas de ${projectName}`} data-pagefind-ignore="all">
  <button class="sidenav-toggle" type="button" aria-expanded="false" aria-controls="sidenav-list">Páginas de {projectName}</button>
  <div class="sidenav-list" id="sidenav-list">
    {sections(pages).map((s) => (
      <div>
        <h2>{s.label}</h2>
        <ul>
          {s.pages.filter((p) => !(rutas && p.path === "rutas.md")).map((p) => (
            <li><a href={p.route} data-astro-prefetch aria-current={p.route === currentRoute ? "page" : undefined}>{p.type === "index" ? `Resumen de ${s.label.toLowerCase()}` : p.title}</a></li>
          ))}
        </ul>
      </div>
    ))}
    <div class="favoritos" data-favoritos-lista data-proyecto={projectId} hidden>
      <h2>Favoritos</h2>
    </div>
    <ul class="extra">
      {rutas && <li><a href={rutas} data-astro-prefetch aria-current={currentRoute === rutas ? "page" : undefined}>Rutas por rol</a></li>}
      <li><a href={`/${projectId}/novedades/`} data-astro-prefetch aria-current={currentRoute === `/${projectId}/novedades/` ? "page" : undefined}>Novedades</a></li>
      <li><a href={`/${projectId}/grafo/`} data-astro-prefetch>Grafo de nodos ROS</a></li>
      {hasDiagrams && <li><a href={`/${projectId}/#diagramas`} data-astro-prefetch>Diagramas</a></li>}
    </ul>
  </div>
</nav>
<script>
  import "../scripts/personal";
  document.querySelectorAll<HTMLButtonElement>(".sidenav-toggle").forEach((b) =>
    b.addEventListener("click", () => {
      const open = b.closest(".sidenav")!.classList.toggle("open");
      b.setAttribute("aria-expanded", String(open));
    }),
  );
</script>

---
// Página /<id>/rutas/: la propia rutas.md de la wiki como checklist por rol. Sin JS se ven todos los paneles;
// el script (src/scripts/rutas.ts) oculta los que no son del rol activo y guarda el avance en localStorage.
import type { Ruta } from "../lib/rutas";

interface Props {
  projectId: string;
  rutas: Ruta[];
}
const { projectId, rutas } = Astro.props;
---
<div class="rutas" data-proyecto={projectId} data-rutas={JSON.stringify(rutas)}>
  <fieldset class="rutas-roles">
    <legend>Elige tu rol</legend>
    {rutas.map((r, n) => (
      <>
        <input type="radio" name="rol" id={`rol-${r.id}`} value={r.id} checked={n === 0} />
        <label for={`rol-${r.id}`}>{r.nombre}</label>
      </>
    ))}
  </fieldset>
  {rutas.map((r) => (
    <section class="rutas-panel" data-rol={r.id} aria-label={`Ruta ${r.nombre}`}>
      <h2>{r.nombre}</h2>
      <ol class="rutas-pasos">
        {r.pasos.map((s, i) => (
          <li>
            <span class="rutas-check">
              <input type="checkbox" id={`paso-${r.id}-${i}`} data-i={i} />
              <label for={`paso-${r.id}-${i}`}>Leído</label>
            </span>
            <div class="rutas-texto">
              <a href={s.route} data-astro-prefetch>{s.title}</a>
              {s.nota && <span class="muted">{s.nota}</span>}
            </div>
          </li>
        ))}
      </ol>
      <div class="rutas-progreso">
        <progress max={r.pasos.length} value="0" aria-label={`Progreso de la ruta ${r.nombre}`}></progress>
        <p class="rutas-contador" aria-live="polite">0 de {r.pasos.length} pasos leídos</p>
      </div>
      <div class="rutas-acciones">
        <button type="button" class="btn btn-primary" data-continuar>Continuar con el siguiente paso</button>
        <button type="button" class="btn" data-reiniciar>Reiniciar ruta</button>
      </div>
    </section>
  ))}
</div>
<script>
  import "../scripts/rutas";
</script>
